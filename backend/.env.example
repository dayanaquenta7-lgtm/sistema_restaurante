# Copia este archivo como  .env  y completa los valores.
# El archivo .env NUNCA se sube a GitHub (ya está en .gitignore).

# --- Servidor ---
PORT=3000
NODE_ENV=development
# Pon true cuando el sistema esté detrás de HTTPS (Nginx, Caddy, etc.)
COOKIE_SECURE=false
# Pon true si hay un proxy delante (Nginx, Caddy, Cloudflare...) para ver la IP real
CONFIAR_PROXY=false

# --- Base de datos MySQL ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=TU_CLAVE_DE_MYSQL
DB_NAME=broasteria

# --- Seguridad ---
# Frase larga y secreta (mínimo 16 caracteres). Se usa para guardar los PIN cifrados.
# OJO: si la cambias, todos los PIN dejan de funcionar y hay que volver a asignarlos.
PIN_SECRET=cambia-esto-por-una-frase-larga-y-secreta

# Si la defines, la tablet de asistencia debe enviar esta clave (cabecera x-tablet-key).
# Sirve para que solo la tablet del local pueda marcar asistencia.
TABLET_KEY=

# Horas que dura la sesión: dueño (30 días) y personal de atención (un turno largo)
SESION_HORAS_DUENO=720
SESION_HORAS_ATENCION=14

# Intentos fallidos de PIN permitidos por dispositivo cada 5 minutos
LIMITE_INTENTOS=10

# Segundos mínimos entre marcar entrada y salida (evita doble toque)
ESPERA_SALIDA_SEG=30

# Nombre que sale en los tickets
NEGOCIO_NOMBRE=Super Pollitos El Rey
