{
  "name": "super-pollitos-el-rey",
  "version": "1.0.0",
  "description": "Programa de escritorio de Super Pollitos El Rey: caja, pollo, personal y sueldos. Funciona sin internet.",
  "author": "Super Pollitos El Rey",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "instalador": "node preparar.js && electron-builder --win --x64"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "bo.superpollitos.elrey",
    "productName": "Super Pollitos El Rey",
    "directories": { "output": "dist" },
    "files": ["main.js", "preload.js", "asistente.html", "img/**"],
    "extraResources": [
      { "from": "../backend", "to": "backend", "filter": ["**/*", "!tests/**", "!.env", "!.env.*", "!*.log"] },
      { "from": "../frontend", "to": "frontend" },
      { "from": "../db", "to": "db", "filter": ["*.sql"] }
    ],
    "win": { "target": "nsis", "icon": "img/icono.ico" },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Super Pollitos El Rey",
      "installerLanguages": ["es_ES"],
      "language": "1034"
    }
  }
}
