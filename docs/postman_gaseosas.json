    {
      "name": "0. Salud (servidor + MySQL)",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{base}}/api/salud",
          "host": [
            "{{base}}"
          ],
          "path": [
            "api",
            "salud"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Responde 200', () => pm.response.to.have.status(200));",
              "pm.test('Base conectada', () => pm.expect(pm.response.json().base_de_datos).to.eql('conectada'));"
            ]
          }
        }
      ]
    },
