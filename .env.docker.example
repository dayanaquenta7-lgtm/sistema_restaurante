# Copia este archivo como  .env.docker  (en la raíz del proyecto) y cambia las claves.
# .env.docker NUNCA se sube a GitHub (está en .gitignore).

# Debe ser "broasteria": los scripts de db/ usan ese nombre (USE broasteria).
DB_NAME=broasteria
# Usuario propio de la app (MySQL no permite usar "root" en MYSQL_USER)
DB_USER=broasteria_app
DB_PASSWORD=CAMBIA_ESTA_CLAVE_LOCAL
# Clave del administrador de MySQL dentro del contenedor
DB_ROOT_PASSWORD=CAMBIA_ESTA_CLAVE_ROOT
